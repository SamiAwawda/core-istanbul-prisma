{
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:db": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy"
  }
}
