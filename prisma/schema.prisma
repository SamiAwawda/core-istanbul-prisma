generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model course_schedules {
  id          Int      @id @default(autoincrement())
  course_id   Int
  day_of_week week_day
  start_time  DateTime @db.Time(6)
  end_time    DateTime @db.Time(6)
  courses     courses  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([course_id, day_of_week, start_time], map: "course_schedules_course_id_day_of_week_start_time_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model courses {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(150)
  description      String?
  start_date       DateTime?          @db.Date
  end_date         DateTime?          @db.Date
  status           course_status      @default(planned)
  room_id          Int?
  supervisor_id    Int?               @unique
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  course_schedules course_schedules[]
  hackathon        hackathons?
  rooms            rooms?             @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  instructors      instructors[]
  students         students[]
  supervisor       supervisors?       @relation(fields: [supervisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model hackathon_team_members {
  id              Int             @id @default(autoincrement())
  team_id         Int
  student_id      Int             @unique
  member_role     member_role     @default(member)
  joined_at       DateTime?       @default(now()) @db.Timestamp(6)
  hackathon_teams hackathon_teams @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students        students        @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model hackathon_teams {
  id                     Int                      @id @default(autoincrement())
  hackathon_id           Int
  team_name              String                   @db.VarChar(100)
  project_title          String?                  @db.VarChar(150)
  project_description    String?
  final_score            Decimal?                 @db.Decimal(5, 2)
  final_rank             Int?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  hackathon_team_members hackathon_team_members[]
  hackathons             hackathons               @relation(fields: [hackathon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([hackathon_id, team_name], map: "hackathon_teams_hackathon_id_team_name_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model hackathons {
  id              Int               @id @default(autoincrement())
  course_id       Int               @unique
  title           String            @db.VarChar(150)
  description     String?
  event_date      DateTime          @db.Date
  start_time      DateTime          @db.Time(6)
  end_time        DateTime          @db.Time(6)
  room_id         Int?
  instructor_id   Int?
  status          hackathon_status  @default(planned)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  courses         courses           @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hackathon_teams hackathon_teams[]
  instructors     instructors?      @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms           rooms?            @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model instructors {
  id             Int          @id @default(autoincrement())
  full_name      String       @db.VarChar(150)
  email          String       @unique @db.VarChar(255)
  phone          String?      @db.VarChar(25)
  specialization String?      @db.VarChar(150)
  course_id      Int?
  created_at     DateTime?    @default(now()) @db.Timestamp(6)
  hackathons     hackathons[]
  courses        courses?     @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model rooms {
  id         Int          @id @default(autoincrement())
  name       String       @unique @db.VarChar(100)
  building   String?      @db.VarChar(100)
  floor      Int?
  capacity   Int
  equipment  String?
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  courses    courses[]
  hackathons hackathons[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model students {
  id                     Int                     @id @default(autoincrement())
  full_name              String                  @db.VarChar(150)
  email                  String                  @unique @db.VarChar(255)
  phone                  String?                 @db.VarChar(25)
  registration_date      DateTime?               @db.Date
  course_id              Int?
  created_at             DateTime?               @default(now()) @db.Timestamp(6)
  courses                courses?                @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hackathon_team_members hackathon_team_members?

  @@index([course_id], map: "idx_students_course_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model supervisors {
  id         Int       @id @default(autoincrement())
  full_name  String    @db.VarChar(150)
  email      String    @unique @db.VarChar(255)
  phone      String?   @db.VarChar(25)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  courses    courses?
}

enum course_status {
  planned
  active
  completed
  cancelled
}

enum hackathon_status {
  planned
  active
  completed
  cancelled
}

enum member_role {
  leader
  member
}

enum week_day {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}
